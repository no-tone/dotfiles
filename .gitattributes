# Normalize line endings in the repo instead of relying on each machine's
# core.autocrlf. Critical here: install.sh / bootstrap.sh MUST stay LF or they
# break when a Windows clone (core.autocrlf=true) would otherwise add CRLF.

* text=auto eol=lf

# Shell scripts: always LF.
*.sh    text eol=lf
bootstrap.sh text eol=lf

# PowerShell / batch: CRLF is safest for native Windows tooling.
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Treat these as text (LF) explicitly.
*.lua   text eol=lf
*.zsh   text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.jsonc text eol=lf
*.toml  text eol=lf
.zshrc      text eol=lf
.zprofile   text eol=lf
.gitconfig  text eol=lf
